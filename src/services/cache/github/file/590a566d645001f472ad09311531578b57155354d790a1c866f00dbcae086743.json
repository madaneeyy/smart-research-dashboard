"#include \"ctranslate2/ops/mul.h\"\n\n#include \"dispatch.h\"\n\nnamespace ctranslate2 {\n  namespace ops {\n\n    void Mul::operator()(const StorageView& a, const StorageView& b, StorageView& c) const {\n      PROFILE(\"Mul\");\n      DEVICE_AND_TYPE_DISPATCH(a.device(), a.dtype(), (compute<D, T>(a, b, c)));\n    }\n\n  }\n}\n"