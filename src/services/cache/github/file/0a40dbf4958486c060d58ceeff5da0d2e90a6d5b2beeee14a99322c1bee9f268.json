"#include \"ctranslate2/ops/cos.h\"\n\n#include \"dispatch.h\"\n\nnamespace ctranslate2 {\n  namespace ops {\n\n    void Cos::operator()(const StorageView& x, StorageView& y) const {\n      PROFILE(\"Cos\");\n\n      y.resize_as(x);\n\n      DEVICE_AND_FLOAT_DISPATCH(\"Cos\", x.device(), x.dtype(),\n                                (primitives<D>::cos(x.data<T>(), y.data<T>(), x.size())));\n    }\n\n  }\n}\n"