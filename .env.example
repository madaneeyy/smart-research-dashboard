# GitHub
GITHUB_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# =========================
# LLM Configuration
# =========================

# Local development:
# ollama = use local Ollama
# groq   = use Groq API
LLM_PROVIDER=ollama

# =========================
# Ollama (local)
# =========================
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=1000
OLLAMA_KEEP_ALIVE=5m

# =========================
# Groq (local testing / Render)
# =========================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Embedding provider
EMBEDDING_MODE=remote
HF_TOKEN=

# Document RAG reranker
RERANKER_ENABLED=false