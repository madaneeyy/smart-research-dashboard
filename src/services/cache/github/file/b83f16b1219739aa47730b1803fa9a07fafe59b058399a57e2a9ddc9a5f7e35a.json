"#include \"ctranslate2/ops/sin.h\"\n\n#include \"dispatch.h\"\n\nnamespace ctranslate2 {\n  namespace ops {\n\n    void Sin::operator()(const StorageView& x, StorageView& y) const {\n      PROFILE(\"Sin\");\n\n      y.resize_as(x);\n\n      DEVICE_AND_FLOAT_DISPATCH(\"Sin\", x.device(), x.dtype(),\n                                (primitives<D>::sin(x.data<T>(), y.data<T>(), x.size())));\n    }\n\n  }\n}\n"